# Lost Kingsland Web V28 — Integration Hub
WEB_PORT=8788
WEB_DATA_MODE=DATABASE
WEB_GAMEPLAY_CONFIG=LK-V4.0-P15-RC-001

# Read-only PostgreSQL role from database/create_web_readonly_role.sql
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/lost_kingsland_v4_reconciled
DATABASE_USER=lost_kingsland_web_ro
DATABASE_PASSWORD=your-readonly-database-password

# Local testing only. Disable on a public deployment after Discord OAuth is configured.
WEB_DEMO_LOGIN=false

# Authoritative gameplay gateway. Web never settles gameplay by itself.
GAME_CORE_BASE_URL=http://127.0.0.1:8080
GAME_CORE_SERVICE_TOKEN=

# V28 direct integration status / operation links
# Internal addresses used by the Web server itself:
ADMIN_BASE_URL=http://127.0.0.1:8787
ADMIN_HEALTH_PATH=/api/health
ADMIN_SERVICE_TOKEN=
BOT_BASE_URL=http://127.0.0.1:8080
BOT_HEALTH_PATH=/actuator/health
BOT_SERVICE_TOKEN=

# Browser-facing links shown in the left floating dock and Operations Hub.
# For remote users, use HTTPS/public URLs rather than 127.0.0.1.
ADMIN_PUBLIC_URL=
BOT_PUBLIC_URL=

# Optional stable public Web URL. Leave empty and Web derives the current host,
# including Cloudflare Tunnel Forwarded headers.
WEB_PUBLIC_BASE_URL=

# payOS webhook relay target. Leave empty to default to:
#   BOT_BASE_URL/api/payments/payos/webhook
PAYOS_WEBHOOK_TARGET_URL=

# IMPORTANT: PAYOS_CLIENT_ID/API_KEY/CHECKSUM_KEY belong in BOT/Game Core,
# not this public Web project. Bot verifies payOS and credits economy.

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://127.0.0.1:8788/auth/discord/callback
